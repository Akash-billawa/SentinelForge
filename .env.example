# SentinelForge configuration
# Copy to .env and fill in values. NEVER commit the real .env file.

# --- Model provider (configure in TrueForge Settings -> Models) ---
# Example: OpenAI-compatible providers. The key is stored by TrueForge, not here.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- TrueForge server ---
TRUEFORGE_BASE_URL=http://localhost:8790

# --- SentinelForge MCP security tooling server ---
SENTINELFORGE_MCP_HOST=127.0.0.1
SENTINELFORGE_MCP_PORT=8765
# Absolute path to this repository root (auto-detected if unset)
SENTINELFORGE_REPO_ROOT=

# --- Incident console (demo UI) ---
SENTINELFORGE_UI_PORT=8090

# --- Model used for the SOC Commander AgentSpec ---
# Must match a model configured in TrueForge Settings -> Models.
# Gemini FREE tier: only flash models have quota (pro = 0 requests/day):
SENTINELFORGE_MODEL=google-gemini/gemini-3-6-flash
# Paid/other provider examples:
# SENTINELFORGE_MODEL=openai/gpt-5.4-mini
# SENTINELFORGE_MODEL=anthropic/claude-haiku-4-5
