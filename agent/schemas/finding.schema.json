{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelForge Finding",
  "type": "object",
  "required": ["finding", "evidence", "confidence"],
  "properties": {
    "finding": { "type": "string", "minLength": 8 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(windows_events|dns|flows|process_tree|artifact|ioc):[A-Za-z0-9._:/-]+$"
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_agent": { "type": "string" },
    "category": {
      "type": ["string", "null"],
      "enum": [
        "powershell_execution",
        "encoded_command",
        "suspicious_dns",
        "beacon_pattern",
        "threat_intel_match",
        "suspicious_artifact",
        "iocs",
        null
      ]
    },
    "why_it_matters": { "type": "string" },
    "recorded_at": { "type": "string" }
  }
}
